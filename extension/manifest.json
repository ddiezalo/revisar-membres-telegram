{
  "manifest_version": 3,
  "name": "Revisar membres de Telegram",
  "short_name": "Revisar membres",
  "version": "0.3.4",
  "description": "Compara membres de grups de Telegram mitjançant MTProto i desa els resultats localment.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://web.telegram.org/*",
    "https://*.telegram.org/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://web.telegram.org/a/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' https://*.telegram.org wss://*.telegram.org;"
  },
  "options_page": "options.html",
  "action": {
    "default_title": "Revisar membres",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
